# Kraken Spot REST API credentials
KRAKEN_PUBLIC_KEY=your_public_api_key_here
KRAKEN_SECRET_KEY=your_base64_encoded_secret_key_here

# Stable IDs from Kraken's Funding API for the USD route and saved destination
USD_FUNDING_METHOD_ID=your_usd_funding_method_uuid
USD_FUNDING_ADDRESS_ID=your_saved_funding_address_id

# Optional settings
KRAKEN_API_URL=https://api.kraken.com
MINIMUM_WITHDRAWAL_USD=10
